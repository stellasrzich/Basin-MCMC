\newif\ifottableau@fingerfirst
\ottableau@fingerfirsttrue

% --- fixed macro ---
\newcommand{\rowletters}[1]{%
  \ifottableau@fingerfirst
    #1%
  \else
    \rowletter
  \fi
}

