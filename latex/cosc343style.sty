% ---------- TITLE FORMAT ----------
\makeatletter
\def\@maketitle{
  \noindent
  {\Large \bfseries \color{black} \@papercode{}: \@title} \\[0.25em]
  \hrule\vspace{0.25em}
  \noindent \@author{} (\@studentid) \\[0.25em]
  \@date
}
\makeatother

