% ---------- CUSTOM COMMANDS ----------
\let\@papercode\@empty
\let\@supervisors\@empty
\let\@reportdate\@empty
\let\@studentid\@empty
\let\@shorttitle\@empty

\newcommand{\papercode}[1]{\gdef\@papercode{#1}}
\newcommand{\supervisors}[1]{\gdef\@supervisors{#1}}
\newcommand{\reportdate}[1]{\gdef\@reportdate{#1}}
\newcommand{\studentid}[1]{\gdef\@studentid{#1}}
\newcommand{\shorttitle}[1]{\gdef\@shorttitle{#1}}

\newif\ifthanks@
\thanks@false
\def\thanksfile#1{\gdef\@thanksfile{#1}\thanks@true}

\def\supervisor#1{\gdef\@supervisor{#1}}
